
@page "/snake"
@rendermode InteractiveServer
@using Blazor.Extensions
@using Blazor.Extensions.Canvas
@using Blazor.Extensions.Canvas.Canvas2D
@using System.Numerics
@using System.Diagnostics
@using System.Text.Json
@using Models
@using Controllers
@inject IJSRuntime JsRuntime;

<PageTitle> Snake Game </PageTitle>

<div class="game-viewport">
    <!-- Connection Panel - Top Left Corner -->
    <div class="connection-panel @(network.IsConnected ? "minimized" : "")">
        <div class="panel-header">
            <h3>🐍 Snake</h3>
        </div>
        <div class="panel-content">
            @if (!network.IsConnected)
            {
                <div class="input-field">
                    <input type="text" @bind="Name" placeholder="Name" />
                </div>
                <div class="input-field">
                    <input type="text" @bind="ServerNameOrAddress" placeholder="127.0.0.1" />
                </div>
                <div class="input-field">
                    <input type="number" @bind="ServerPort" placeholder="11000" />
                </div>
                <button class="btn btn-connect" disabled="@network.disconnected" @onclick="Connect">
                    Connect
                </button>
            }
            else
            {
                <div class="status-info">
                    <p>✓ Connected</p>
                    <p class="controls-hint">WASD / Arrows to move</p>
                </div>
                <button class="btn btn-disconnect" @onclick="network.DisconnectFromServer">
                    Disconnect
                </button>
            }
        </div>
    </div>

    <!-- Game Canvas - Full Screen -->
    <div class="game-canvas-wrapper">
        <BECanvas Width="1000" Height="1000" @ref="canvasReference"></BECanvas>
    </div>
</div>

<img @ref="backgroundImage" id="bgImage" src="images/Background.png" alt="image" style="display:none;" />
<img @ref="wallSprite" id="bgImage2" src="images/WallSprite.png" alt="image" style="display:none;" />

@if (network.disconnected || network.NameError)
{
    <div class=error-popup-container>
        <h1 class="error-header">@network.errorMessage</h1>
        <btn @onclick="ErrorWindowClickHandler" class=error-button>Close Window</btn>
    </div>
}

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background: #1a1a2e;
        overflow: hidden;
    }

    .game-viewport {
        width: 100vw;
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        position: relative;
        background: radial-gradient(circle at center, #16213e 0%, #0f1419 100%);
    }

    .connection-panel {
        position: absolute;
        top: 20px;
        left: 20px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(10px);
        border-radius: 12px;
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
        padding: 20px;
        width: 280px;
        z-index: 100;
        transition: all 0.3s ease;
    }

    .connection-panel.minimized {
        width: 200px;
        padding: 15px;
    }

    .panel-header {
        margin-bottom: 15px;
    }

    .panel-header h3 {
        font-size: 1.4em;
        color: #333;
        margin: 0;
    }

    .connection-panel.minimized .panel-header h3 {
        font-size: 1.2em;
    }

    .panel-content {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .input-field {
        display: flex;
    }

    .input-field input {
        width: 100%;
        padding: 10px;
        border: 2px solid #e0e0e0;
        border-radius: 6px;
        font-size: 0.95em;
        transition: border-color 0.3s;
    }

    .input-field input:focus {
        outline: none;
        border-color: #667eea;
    }

    .status-info {
        background: #f0f9ff;
        padding: 12px;
        border-radius: 6px;
        border-left: 4px solid #667eea;
    }

    .status-info p {
        margin: 5px 0;
        font-size: 0.9em;
        color: #333;
    }

    .controls-hint {
        font-size: 0.85em !important;
        color: #666 !important;
    }

    .btn {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 6px;
        font-size: 0.95em;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .btn-connect {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .btn-connect:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(102, 126, 234, 0.5);
    }

    .btn-connect:disabled {
        background: #ccc;
        cursor: not-allowed;
    }

    .btn-disconnect {
        background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        color: white;
        font-size: 0.85em;
    }

    .btn-disconnect:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(245, 87, 108, 0.5);
    }

    .game-canvas-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        background: white;
        border-radius: 8px;
        box-shadow: 0 0 50px rgba(0, 0, 0, 0.5);
        padding: 0;
    }

    .error-popup-container {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 90%;
        max-width: 400px;
        padding: 25px;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(10px);
        border: 3px solid #e83c3c;
        border-radius: 12px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 15px;
        z-index: 1000;
    }

    .error-header {
        text-align: center;
        color: #e83c3c;
        font-size: 1.2em;
        margin: 0;
    }

    .error-button {
        padding: 10px 25px;
        border: 2px solid #333;
        background-color: #f5f5f5;
        border-radius: 6px;
        cursor: pointer;
        font-weight: 600;
        transition: all 0.3s;
    }

    .error-button:hover {
        background-color: #e0e0e0;
        transform: translateY(-2px);
    }
</style>



@code
{
    private BECanvasComponent canvasReference = null!;
    private Canvas2DContext context = null!;
    private IJSObjectReference jsModule = null!;

    /// <summary>
    /// variable representing communication with controller
    /// </summary>
    private NetworkController network = new(); //instance of controller class

    /// <summary>
    /// Server name/address used for connection
    /// </summary>
    private string ServerNameOrAddress = "localhost"; //default server address
    /// <summary>
    /// server port
    /// </summary>
    private int ServerPort = 11000; //default port
    /// <summary>
    /// name of player, where default is emtpy
    /// </summary>
    private string Name = string.Empty;
    /// <summary>
    /// instance of World class representing this world
    /// </summary>
    private World thisWorld = new(0);
    /// <summary>
    /// default value representing view (canvas) width
    /// </summary>
    private const int ViewWidth = 1000;
    /// <summary>
    /// default value representing view (canvas) height
    /// </summary>
    private const int ViewHeight = 1000;

    /// <summary>
    /// Timer for simulating the frame rate of a game
    /// </summary>
    System.Diagnostics.Stopwatch watch = new System.Diagnostics.Stopwatch();


    /// <summary>
    /// default options for the colors of snakes, where first player is white, second player is blue, etc.
    /// </summary>
    private String[] colorOptions = { "white", "blue", "green", "purple", "orange", "pink", "brown", "yellow" }; //make this const?


    /// <summary>
    /// C# reference to the html element for the background image
    /// </summary>
    private ElementReference backgroundImage;

    /// <summary>
    /// c# reference to the html element for the wallsprites
    /// </summary>
    private ElementReference wallSprite;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./Pages/SnakeGUI.razor.js");
            context = await canvasReference.CreateCanvas2DAsync();
            await JsRuntime.InvokeAsync<object>("initRenderJS", DotNetObjectReference.Create(this));
        }

    }


    /// <summary>
    /// Renders the view once every 20 milliseconds (50 frames/second)
    /// </summary>
    private async void GameLoop()
    {
        while (network.IsConnected)
        {
            await DrawFrame();
            await Task.Delay(20); // Non-blocking delay instead of Thread.Sleep
        }
    }


    /// <summary>
    ///draws the frame given the world specifications
    /// </summary>
    /// <returns></returns>
    private async Task DrawFrame()
    {
        World copyOfWorld = network.copyWorld();//get network's copy of world

        await context.BeginBatchAsync();




        await context.SetFillStyleAsync("blue");
        await context.FillRectAsync(0, 0, ViewWidth, ViewHeight);




        // clip the view so that objects drawn outside the canvas will not be shown
        await context.BeginPathAsync();
        // await context.ClearRectAsync();
        await context.RectAsync(0, 0, ViewWidth, ViewHeight);
        await context.ClipAsync();

        // Because we are modifying the transformation matrix, we need to save it so we can restore it at the end
        await context.SaveAsync();

        // Get this snake head point
        Snake thisSnake = new();
        Point2D head = new();



        if (copyOfWorld.snakes.TryGetValue(network.thisID, out thisSnake!))
        {
            int length = thisSnake.body.Count;
            head = thisSnake.body[length - 1];
        }



        // Center on origin, move to center of view port
        await context.TranslateAsync(ViewWidth / 2, ViewHeight / 2);
        await context.TranslateAsync(-head.X, -head.Y);

        //Draw the background:
        await context.DrawImageAsync(backgroundImage, -copyOfWorld.size / 2, -copyOfWorld.size / 2, copyOfWorld.size, copyOfWorld.size);



        //Drawing the Walls
        foreach (Wall wall in copyOfWorld.walls.Values)
        {
            //find lower and upper x and y values of wall segment
            int startX = Math.Min(wall.point1.X, wall.point2.X);
            int startY = Math.Min(wall.point1.Y, wall.point2.Y);
            int endX = Math.Max(wall.point1.X, wall.point2.X);
            int endY = Math.Max(wall.point1.Y, wall.point2.Y);

            // Draw the wall in segments
            for (int x = startX; x <= endX; x += 50)
            {
                for (int y = startY; y <= endY; y += 50)
                {
                    await context.DrawImageAsync(wallSprite, x - 25, y - 25, 50, 50);
                }
            }
        }

        //Drawing the Snakes

        string messageActivity = string.Empty;
        foreach (Snake s in copyOfWorld.snakes.Values)
        {

            //treating two points in the body as a line segment
            for (int pair = 0; pair < s.body.Count - 1; pair++)
            {
                string style = string.Empty;
                //death animation sequence
                if (!s.alive || s.died)
                {
                    style = "red";
                }
                else
                {
                    style = colorOptions[s.ID % 8];
                }

                //draw name
                Point2D snakesHead = s.body[s.body.Count - 1];
                await context.SetFillStyleAsync("black");

                if (s.dir.Y == 1)
                {
                    await context.FillTextAsync($"{s.name}: {s.score}", snakesHead.X + 10, snakesHead.Y + 10);
                }
                else
                {
                    await context.FillTextAsync($"{s.name}: {s.score}", snakesHead.X - 10, snakesHead.Y - 10);
                }


                if (s.body[pair].X == s.body[pair + 1].X)//x's are equal, segment is vertical
                {


                    int y2 = Math.Max(s.body[pair].Y, s.body[pair + 1].Y);
                    int y1 = Math.Min(s.body[pair].Y, s.body[pair + 1].Y);//y2 is the lesser of the two y values
                    int sharedX = s.body[pair].X;
                    for (int i = y1; i <= y2; i++)
                    {

                        await context.SetLineWidthAsync(1);
                        await context.BeginPathAsync();
                        await context.SetStrokeStyleAsync(style);
                        await context.ArcAsync(sharedX, i, 5, 0, 2 * Math.PI);
                        await context.StrokeAsync();


                    }
                }
                else//y's are equal, segment is horizontal
                {


                    int x2 = Math.Max(s.body[pair].X, s.body[pair + 1].X);
                    int x1 = Math.Min(s.body[pair].X, s.body[pair + 1].X);//y2 is the lesser of the two y values
                    int sharedY = s.body[pair].Y;
                    for (int i = x1; i <= x2; i++)
                    {

                        await context.SetLineWidthAsync(1);
                        await context.BeginPathAsync();
                        await context.SetStrokeStyleAsync(style);
                        await context.ArcAsync(i, sharedY, 5, 0, 2 * Math.PI);
                        await context.StrokeAsync();


                    }
                }
            }




        }



        //Drawing the Powerups
        foreach (Powerup powerup in copyOfWorld.powerups.Values)
        {
            await context.SetLineWidthAsync(5);
            await context.SetStrokeStyleAsync($"rgb( 255, 255, 0 )");
            await context.BeginPathAsync();

            await context.ArcAsync(powerup.location.X, powerup.location.Y, 8, 0, 2 * Math.PI);
            await context.StrokeAsync();
        }

        //draw "dead" powerups whose animation is still going
        PowerupDeathAnimationHandler animationHandler = copyOfWorld.animationHandler;
        Powerup[] recentlyDiedPowerups = animationHandler.getPowerups();
        foreach (Powerup pow in recentlyDiedPowerups)
        {
            double radius = animationHandler.getPowerUpRadius(pow);
            await context.BeginPathAsync();
            await context.ArcAsync(pow.location.X, pow.location.Y, radius, 0, 2 * Math.PI);
            await context.StrokeAsync();
        }




        await context.RestoreAsync();
        await context.EndBatchAsync();

        StateHasChanged();

    }


    [JSInvokable]
    public void HandleKeyPress(string key)
    {
        if (network.IsConnected && network.handShake)
        {
            network.sendGameCommands(key); // No need for a new thread for simple send operation
        }
    }

    /// <summary>
    /// Handles click of the network button
    /// </summary>
    private void Connect()
    {
        try
        {
            Console.WriteLine($"Attempting to connect to {ServerNameOrAddress}:{ServerPort} with name '{Name}'");
            network.NetworkLoop(ServerNameOrAddress, ServerPort, Name);
            Console.WriteLine("NetworkLoop completed successfully");
            GameLoop();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Connection failed with exception: {ex.GetType().Name} - {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            network.NetworkError(false);
        }
    }

    /// <summary>
    /// resolves the network error when button is clicked
    /// </summary>
    private void ErrorWindowClickHandler()
    {
        network.resolveError();
    }

}


